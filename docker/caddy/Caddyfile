# AMCore — optional bundled edge (COMPOSE_PROFILES=...,edge). Caddy REPLACES a
# reverse proxy — do not run it alongside nginx/Traefik/a cloud LB. See
# docs/operations/deployment.md → "TLS & reverse proxy" → "Optional bundled
# edge: Caddy".
#
# Automatic HTTPS needs CADDY_DOMAIN's A/AAAA record pointed at this host and
# ports 80/443 reachable from the internet (ACME HTTP-01 challenge). For local
# testing without a public domain, replace `{$CADDY_DOMAIN}` below with
# `localhost` and add `tls internal` inside the block instead.
{
	email {$CADDY_EMAIL}
}

{$CADDY_DOMAIN} {
	reverse_proxy api:5002
}

{$CADDY_WEB_DOMAIN:app.invalid} {
	reverse_proxy web:3000 {
		header_up Host {host}
	}
}

# AMCORE_ADMIN_CONSOLE_PROXY_START — PR5 owns this block's deletion transform.
{$ADMIN_CONSOLE_HOSTNAME:console.invalid} {
	@physicalConsolePath path /admin /admin/*
	handle @physicalConsolePath {
		respond 404
	}

	@consoleTrailingSlash path_regexp consoleTrailingSlash ^(/(?:en|ru)(?:/.*[^/])?)/$
	handle @consoleTrailingSlash {
		redir {re.consoleTrailingSlash.1}?{query} 308
	}

	@cspReport path /api/csp-report
	handle @cspReport {
		reverse_proxy web:3000 {
			header_up Host {host}
		}
	}

	@consoleApi path /api/*
	handle @consoleApi {
		uri replace /api/ /api/console/
		reverse_proxy web:3000 {
			header_up Host {host}
		}
	}

	@consolePage path_regexp consolePage ^/(en|ru)(/.*)?$
	handle @consolePage {
		rewrite * /{re.consolePage.1}/admin{re.consolePage.2}
		reverse_proxy web:3000 {
			header_up Host {host}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up Host {host}
		}
	}
}
# AMCORE_ADMIN_CONSOLE_PROXY_END
