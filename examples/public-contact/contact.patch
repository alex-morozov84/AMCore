@@ -0,0 +1,64 @@
+import { randomUUID } from 'node:crypto'
+
+import request from 'supertest'
+
+import type { SendEmailParams } from '../src/infrastructure/email/email.types.js'
+
+import { type E2ETestContext, setupE2ETest, teardownE2ETest } from './helpers'
+
+const deliveries: SendEmailParams[] = []
+let context: E2ETestContext
+
+beforeAll(async () => {
+  context = await setupE2ETest(
+    (builder) =>
+      builder.overrideProvider('EmailProvider').useValue({
+        async send(mail: SendEmailParams) {
+          deliveries.push(mail)
+          return { id: randomUUID(), success: true }
+        },
+      }),
+    { productionOrder: true }
+  )
+}, 120_000)
+
+afterAll(async () => {
+  if (context) await teardownE2ETest(context)
+}, 120_000)
+
+const input = { email: 'visitor@example.com', message: 'What are your opening hours?' }
+
+function submit(data: object, key = randomUUID()) {
+  return request(context.app.getHttpServer())
+    .post('/api/v1/contact')
+    .set('Idempotency-Key', key)
+    .send(data)
+}
+
+function expectDeliveriesSince(before: number, count: number) {
+  expect(deliveries.length - before).toBe(count)
+}
+
+it('counts every delivery independently of the submission identifier', async () => {
+  const before = deliveries.length
+  const key = randomUUID()
+  await submit(input, key).expect(200, { accepted: true })
+  await submit(input, key).expect(200).expect('idempotency-replayed', 'true')
+  expectDeliveriesSince(before, 1)
+  expect(deliveries.at(-1)?.to).toBe('contact@example.com')
+
+  await submit(input).expect(200)
+  expect(() => expectDeliveriesSince(before, 1)).toThrow()
+  expectDeliveriesSince(before, 2)
+})
+
+it('refuses invalid and excess attempts without delivering mail', async () => {
+  await context.throttlerStorage.reset()
+  const before = deliveries.length
+  await submit({ ...input, website: 'robot' }).expect(400)
+  await submit({ ...input, message: '  ' }).expect(400)
+  await submit({ ...input, message: 'x'.repeat(2001) }).expect(400)
+  await submit({ ...input, message: 'x'.repeat(17_000) }).expect(413)
+  await submit(input).expect(429).expect('retry-after', /^\d+$/)
+  expectDeliveriesSince(before, 0)
+})
