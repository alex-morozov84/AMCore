@@ -0,0 +1,128 @@
+import { randomUUID } from 'node:crypto'
+
+import { expect, test } from '@playwright/test'
+
+import { expectNoAxeViolations } from '../shared/axe'
+import { messages, productPath } from '../shared/product-settings'
+import { activeTarget } from '../support/managed-target.mjs'
+
+const copy = messages.contactExample
+const input = { email: 'visitor@example.com', message: '  What are your opening hours?  ' }
+
+async function mailCount() {
+  const port = activeTarget().ports.api
+  const response = await fetch(`http://127.0.0.1:${port}/api/v1/metrics`, {
+    redirect: 'error',
+    signal: AbortSignal.timeout(3000),
+  })
+  expect(response.ok).toBe(true)
+  return (await response.text())
+    .split('\n')
+    .filter(
+      (line) =>
+        line.startsWith('amcore_email_operations_total{') &&
+        ['operation="send"', 'mode="direct"', 'result="success"'].every((label) =>
+          line.includes(label)
+        )
+    )
+    .reduce((total, line) => total + Number(line.slice(line.lastIndexOf(' ') + 1)), 0)
+}
+
+test.describe.configure({ mode: 'serial' })
+
+test('retains and reuses a submission when the response is lost', async ({ page }) => {
+  const before = await mailCount()
+  await page.goto(productPath('/contact'))
+  const email = page.getByRole('textbox', { name: copy.email })
+  const message = page.getByRole('textbox', { name: copy.message })
+  await expectNoAxeViolations(page)
+  await email.fill(input.email)
+  await message.fill(input.message)
+
+  const releaseResponse = Promise.withResolvers<void>()
+  const attempts: Array<{ key: string; body: string | null }> = []
+  await page.route('**/api/contact', async (route) => {
+    const request = route.request()
+    attempts.push({ key: request.headers()['idempotency-key'] ?? '', body: request.postData() })
+    const response = await route.fetch()
+    if (attempts.length === 1) {
+      expect(response.status()).toBe(200)
+      await releaseResponse.promise
+      await route.abort()
+      return
+    }
+    await route.fulfill({ response })
+  })
+
+  try {
+    await page.getByRole('button', { name: copy.send }).dblclick()
+    await expect(page.getByRole('button', { name: copy.sending })).toBeDisabled()
+    for (const [field, value] of [
+      [email, input.email],
+      [message, input.message],
+    ] as const) {
+      await expect(field).not.toBeEditable()
+      await field.focus()
+      await page.keyboard.type(' changed')
+      await expect(field).toHaveValue(value)
+    }
+  } finally {
+    releaseResponse.resolve()
+  }
+  const retry = page.getByRole('button', { name: copy.retry })
+  await expect(retry).toBeEnabled()
+  expect(attempts).toHaveLength(1)
+  await expect(email).toHaveValue(input.email)
+  await expect(message).toHaveValue(input.message)
+  const visibleInput = { email: await email.inputValue(), message: await message.inputValue() }
+  const replay = page.waitForResponse((response) => response.url().endsWith('/api/contact'))
+  await retry.click()
+  expect((await replay).headers()['idempotency-replayed']).toBe('true')
+  await expect(page.getByRole('status')).toHaveText(copy.success)
+  expect(attempts).toHaveLength(2)
+  expect(attempts[0]?.key).not.toBe('')
+  expect(attempts[1]).toEqual(attempts[0])
+  expect(JSON.parse(attempts[0]?.body ?? '{}')).toMatchObject(visibleInput)
+  expect(JSON.parse(attempts[1]?.body ?? '{}')).toMatchObject(visibleInput)
+  expect(await mailCount()).toBe(before + 1)
+})
+
+test('rejects the trap and oversized messages through the browser endpoint', async ({
+  request,
+}) => {
+  const before = await mailCount()
+  const post = (data: object) =>
+    request.post('/api/contact', { data, headers: { 'Idempotency-Key': randomUUID() } })
+  expect((await post({ ...input, website: 'bot' })).status()).toBe(400)
+  expect((await post({ ...input, message: 'x'.repeat(17_000) })).status()).toBe(413)
+  expect(await mailCount()).toBe(before)
+})
+
+test('keeps editable fields and re-enables submit after a rate refusal', async ({ page }) => {
+  const before = await mailCount()
+  await page.goto(productPath('/contact'))
+  const email = page.getByRole('textbox', { name: copy.email })
+  const message = page.getByRole('textbox', { name: copy.message })
+  await email.fill(input.email)
+  await message.fill(input.message)
+  await page.clock.install()
+  await page.route('**/api/contact', (route) =>
+    route.fulfill({ status: 429, headers: { 'Retry-After': '20' }, json: {} })
+  )
+  const button = page.getByRole('button', { name: copy.send })
+  await email.focus()
+  await page.keyboard.press('Tab')
+  await expect(message).toBeFocused()
+  await page.keyboard.press('Tab')
+  await expect(button).toBeFocused()
+  await page.keyboard.press('Enter')
+  await expect(page.locator('[data-slot=alert]')).toHaveText(copy.wait.replace('{seconds}', '20'))
+  await expect(button).toBeDisabled()
+  await expect(email).toBeEditable()
+  await expect(message).toBeEditable()
+  await expect(email).toHaveValue(input.email)
+  await expect(message).toHaveValue(input.message)
+  await page.clock.fastForward(20_000)
+  await expect(button).toBeEnabled()
+  expect(await mailCount()).toBe(before)
+})
diff --git a/apps/web/src/_pages/public-contact/contact-form.tsx b/apps/web/src/_pages/public-contact/contact-form.tsx
new file mode 100644
index 00000000..aebb0685
--- /dev/null
+++ b/apps/web/src/_pages/public-contact/contact-form.tsx
@@ -0,0 +1,130 @@
+'use client'
+
+import { useRef, useState } from 'react'
+import { useTranslations } from 'next-intl'
+import { type ContactInput, contactSchema } from '@amcore/shared'
+
+import { apiClient, ApiRequestError } from '@/shared/api/http-client'
+import { useLocalizedForm } from '@/shared/hooks'
+import { Alert, AlertDescription } from '@/shared/ui/alert'
+import { ApiErrorAlert } from '@/shared/ui/api-error-alert'
+import { Button } from '@/shared/ui/button'
+import { Form, FormControl, FormField, FormItem, FormLabel, FormMessage } from '@/shared/ui/form'
+import { Input } from '@/shared/ui/input'
+
+type Attempt = { key: string; input: ContactInput }
+
+export function ContactForm() {
+  const t = useTranslations('contactExample')
+  const form = useLocalizedForm<ContactInput>(contactSchema, {
+    defaultValues: { email: '', message: '', website: '' },
+  })
+  const active = useRef(false)
+  const attempt = useRef<Attempt | null>(null)
+  const [pending, setPending] = useState(false)
+  const [accepted, setAccepted] = useState(false)
+  const [unknown, setUnknown] = useState(false)
+  const [wait, setWait] = useState(0)
+  const [error, setError] = useState<unknown>()
+
+  async function submit(input: ContactInput) {
+    if (active.current || wait) return
+    active.current = true
+    const current = (attempt.current ??= { key: crypto.randomUUID(), input })
+    setError(undefined)
+    setPending(true)
+
+    try {
+      await apiClient.post('/contact', current.input, {
+        headers: { 'Idempotency-Key': current.key },
+        signal: AbortSignal.timeout(12_000),
+      })
+      attempt.current = null
+      setAccepted(true)
+    } catch (cause) {
+      if (cause instanceof ApiRequestError && cause.status === 429) {
+        const seconds = cause.retryAfterSeconds ?? 1
+        setWait(seconds)
+        setTimeout(() => setWait(0), seconds * 1000)
+        if (!unknown) attempt.current = null
+      } else if (
+        !unknown &&
+        cause instanceof ApiRequestError &&
+        [400, 403, 413].includes(cause.status)
+      ) {
+        attempt.current = null
+        setError(cause)
+      } else {
+        setUnknown(true)
+      }
+    } finally {
+      active.current = false
+      setPending(false)
+    }
+  }
+
+  if (accepted) return <p role="status">{t('success')}</p>
+
+  return (
+    <Form {...form}>
+      <form
+        className="space-y-4"
+        noValidate
+        onSubmit={(event) => {
+          const original = attempt.current
+          if (unknown && original) {
+            event.preventDefault()
+            void submit(original.input)
+            return
+          }
+          void form.handleSubmit(submit)(event)
+        }}
+      >
+        <ApiErrorAlert error={error} />
+        {wait > 0 && (
+          <Alert variant="destructive">
+            <AlertDescription>{t('wait', { seconds: wait })}</AlertDescription>
+          </Alert>
+        )}
+        {unknown && <p role="status">{t('unknown')}</p>}
+        <FormField
+          control={form.control}
+          name="email"
+          render={({ field }) => (
+            <FormItem>
+              <FormLabel>{t('email')}</FormLabel>
+              <FormControl>
+                <Input type="email" autoComplete="email" readOnly={pending || unknown} {...field} />
+              </FormControl>
+              <FormMessage />
+            </FormItem>
+          )}
+        />
+        <FormField
+          control={form.control}
+          name="message"
+          render={({ field }) => (
+            <FormItem>
+              <FormLabel>{t('message')}</FormLabel>
+              <FormControl>
+                <textarea
+                  className="w-full rounded-md border border-input bg-background px-3 py-2"
+                  rows={5}
+                  readOnly={pending || unknown}
+                  {...field}
+                />
+              </FormControl>
+              <FormMessage />
+            </FormItem>
+          )}
+        />
+        <div hidden>
+          <input autoComplete="off" tabIndex={-1} {...form.register('website')} />
+        </div>
+        <Button type="submit" className="w-full" disabled={pending || wait > 0}>
+          {pending ? t('sending') : unknown ? t('retry') : t('send')}
+        </Button>
+      </form>
+    </Form>
+  )
+}
