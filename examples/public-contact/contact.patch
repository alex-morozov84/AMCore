+import { z } from 'zod'
+
+export const contactSchema = z.strictObject({
+  email: z.email().max(254),
+  message: z
+    .string()
+    .max(2000)
+    .refine((message) => message.trim().length > 0),
+  website: z.string().max(254).optional(),
+})
+
+export const contactReceiptSchema = z.object({ accepted: z.literal(true) })
+export const CONTACT_BODY_LIMIT = 16_384
+export type ContactInput = z.input<typeof contactSchema>
