@@ -0,0 +1,5 @@
+/** Match the contact route's case and trailing-slash aliases without changing routing. */
+export function isContactPath(url: string, prefix = '/api/v1'): boolean {
+  const path = url.split('?')[0]?.replace(/\/$/, '').toLowerCase()
+  return path === `${prefix}/contact`.toLowerCase()
+}
