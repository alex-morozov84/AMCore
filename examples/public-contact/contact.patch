diff --git a/apps/web/src/app/api/contact/route.ts b/apps/web/src/app/api/contact/route.ts
new file mode 100644
index 00000000..8cc68a36
--- /dev/null
+++ b/apps/web/src/app/api/contact/route.ts
@@ -0,0 +1,46 @@
+import { CONTACT_BODY_LIMIT } from '@amcore/shared'
+
+import { fetchBackendResponse } from '@/shared/api/backend-transport'
+import { isTrustedOrigin } from '@/shared/api/bff/origin-guard'
+
+export async function POST(request: Request) {
+  if (!isTrustedOrigin(request)) return Response.json({}, { status: 403 })
+  if (request.headers.get('content-type') !== 'application/json' || !request.body) {
+    return Response.json({}, { status: 400 })
+  }
+
+  const body = new Uint8Array(CONTACT_BODY_LIMIT)
+  const reader = request.body.getReader()
+  let size = 0
+  try {
+    for (;;) {
+      const { done, value } = await reader.read()
+      if (done) break
+      if (size + value.length > body.length) {
+        await reader.cancel()
+        return Response.json({}, { status: 413 })
+      }
+      body.set(value, size)
+      size += value.length
+    }
+
+    const upstream = await fetchBackendResponse('/api/v1/contact', request.headers, {
+      method: 'POST',
+      headers: {
+        'content-type': 'application/json',
+        'idempotency-key': request.headers.get('idempotency-key') ?? '',
+      },
+      body: body.subarray(0, size),
+      signal: AbortSignal.timeout(10_000),
+    })
+
+    const headers = new Headers({ 'cache-control': 'no-store' })
+    for (const name of ['content-type', 'retry-after', 'idempotency-replayed']) {
+      const value = upstream.headers.get(name)
+      if (value) headers.set(name, value)
+    }
+    return new Response(upstream.body, { status: upstream.status, headers })
+  } catch {
+    return Response.json({}, { status: 503 })
+  }
+}
