@@ -0,0 +1,69 @@
+import {
+  BadRequestException,
+  Body,
+  Controller,
+  HttpCode,
+  Module,
+  Post,
+  ServiceUnavailableException,
+} from '@nestjs/common'
+import { ApiHeader, ApiOkResponse, ApiOperation, ApiResponse, ApiTags } from '@nestjs/swagger'
+
+import { AuthType, contactReceiptSchema, contactSchema } from '@amcore/shared'
+
+import { createSchemaDto } from '../../common/schemas/schema-dto.js'
+import { Auth } from '../../core/auth/decorators/auth.decorator.js'
+import { EmailModule } from '../../infrastructure/email/email.module.js'
+import { EmailService } from '../../infrastructure/email/email.service.js'
+import { Idempotent } from '../../infrastructure/idempotency/idempotent.decorator.js'
+import { IdempotencyModule } from '../../infrastructure/idempotency/index.js'
+import { RateLimit } from '../../infrastructure/throttling/rate-limit.decorator.js'
+
+class ContactDto extends createSchemaDto(contactSchema) {}
+class ContactReceiptDto extends createSchemaDto(contactReceiptSchema) {}
+
+@ApiTags('Contact example')
+@Controller('contact')
+export class ContactController {
+  constructor(private readonly mail: EmailService) {}
+
+  @Post()
+  @HttpCode(200)
+  @Auth(AuthType.None)
+  @RateLimit({ rate: 5, per: 60_000, burst: 3 })
+  @Idempotent({ scope: 'public-contact-example' })
+  @ApiOperation({ summary: 'Send a message to the configured contact mailbox' })
+  @ApiHeader({ name: 'Idempotency-Key', required: true })
+  @ApiResponse({ status: 400, description: 'Invalid request, trap or key.' })
+  @ApiResponse({ status: 409, description: 'Submission still processing.' })
+  @ApiResponse({ status: 413, description: 'Request too large.' })
+  @ApiResponse({ status: 422, description: 'Key used with different input.' })
+  @ApiResponse({ status: 429, description: 'Too many requests.' })
+  @ApiResponse({ status: 503, description: 'Submission outcome unavailable.' })
+  // Validate the object before returning it. Cached replays return serialized JSON.
+  @ApiOkResponse({
+    schema: {
+      type: 'object',
+      required: ['accepted'],
+      properties: {
+        accepted: { type: 'boolean', enum: [true] },
+      },
+    },
+  })
+  async submit(@Body({ schema: ContactDto.schema }) input: ContactDto): Promise<ContactReceiptDto> {
+    if (input.website) throw new BadRequestException()
+    const text = `From: ${input.email}\n\n${input.message}`
+    const html = text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
+    const result = await this.mail.send({
+      to: 'contact@example.com',
+      subject: 'Contact form message',
+      text,
+      html: `<pre>${html}</pre>`,
+    })
+    if (!result.success) throw new ServiceUnavailableException()
+    return contactReceiptSchema.parse({ accepted: true })
+  }
+}
+
+@Module({ imports: [EmailModule, IdempotencyModule], controllers: [ContactController] })
+export class ContactModule {}
