{
  "name": "@amcore/api",
  "version": "0.0.1",
  "private": true,
  "description": "AMCore API Server",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "pnpm run typecheck:build && nest build -p tsconfig.build.json && node scripts/build-identity.mjs",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "lint": "node ../../scripts/lint.mjs --scope api",
    "typecheck": "node ../../scripts/typecheck-native.mjs --noEmit -p tsconfig.json --tsBuildInfoFile .amcore/typescript7/typecheck.tsbuildinfo",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --passWithNoTests",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:email": "vitest run",
    "test:email:watch": "vitest watch",
    "test:email:ui": "vitest --ui",
    "test:email:cov": "vitest run --coverage",
    "test:e2e": "node ../../scripts/api-e2e-ci.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "organization:setup": "tsx src/cli/organization-setup.ts",
    "telegram:setup": "tsx src/cli/telegram-setup.ts",
    "storage:check": "tsx src/cli/storage-check.ts",
    "lint:fix": "node ../../scripts/lint.mjs --scope api --fix",
    "typecheck:build": "node ../../scripts/typecheck-native.mjs --noEmit -p tsconfig.build.json --tsBuildInfoFile .amcore/typescript7/build.tsbuildinfo"
  },
  "prisma": {
    "schema": "./prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/openai-compatible": "3.0.78",
    "@amcore/shared": "workspace:^",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@bull-board/api": "^9.10.5",
    "@bull-board/fastify": "9.10.5",
    "@bull-board/nestjs": "^9.10.5",
    "@casl/ability": "^7.0.2",
    "@casl/prisma": "^2.0.2",
    "@fastify/compress": "9.2.2",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/view": "12.0.1",
    "@formatjs/intl": "^6.1.4",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.3",
    "@nestjs/terminus": "12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "0.16.1",
    "@react-email/render": "^2.1.1",
    "@redis/client": "^6.3.0",
    "accepts": "2.0.0",
    "ai": "7.0.153",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "bullmq": "6.4.2",
    "content-type": "3.1.1",
    "dotenv": "^18.0.9",
    "fastify": "5.12.7",
    "file-type": "^22.2.0",
    "iconv-lite": "0.7.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "maxmind": "^5.0.7",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "openid-client": "^6.8.8",
    "otplib": "13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "qs": "6.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.34.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@amcore/eslint-config": "workspace:*",
    "@amcore/typescript-config": "workspace:*",
    "@bull-board/express": "^9.10.5",
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/testing": "^12.2.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@swc/jest": "0.2.39",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/accepts": "1.3.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/qs": "6.15.1",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "aws-sdk-client-mock": "^4.1.0",
    "cookie-parser": "^1.4.7",
    "express": "5.3.0",
    "happy-dom": "^21.0.4",
    "jest": "^30.5.2",
    "jest-mock-extended": "4.0.0",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "type": "module"
}
