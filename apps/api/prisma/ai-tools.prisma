// ===========================================
// AI capability layer — tools & approvals (Track C — ADR-054, Arc A)
// ===========================================
// Self-hosted tool loop (owner R3) + human-in-the-loop approvals (owner R5 / OWASP
// LLM01). Persisted now, exercised from Arc E/F. Tools execute host-side under existing
// RBAC/audit/fences; no product tools ship this track.

/// Tool-invocation lifecycle (Arc E). `AWAITING_APPROVAL` pauses on the HITL gate.
enum AiToolInvocationStatus {
  REQUESTED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  SUCCEEDED
  FAILED
  SKIPPED
  /// The tool may or may not have produced its external effect (timeout, crash, unclassified error of
  /// a side-effecting tool). A stop state: it never authorizes another execution or a new action.
  OUTCOME_UNKNOWN

  @@schema("ai")
}

/// Tool risk class — drives the approval requirement (least-privilege, LLM01).
enum AiToolRiskClass {
  SAFE
  SENSITIVE
  DESTRUCTIVE

  @@schema("ai")
}

/// What a human-in-the-loop approval gates.
enum AiApprovalKind {
  TOOL_INVOCATION
  HANDOFF
  SENSITIVE_ACTION

  @@schema("ai")
}

/// Approval decision lifecycle.
enum AiApprovalState {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@schema("ai")
}

/// One self-hosted tool invocation (Arc E). `argsSnapshot`/`resultSummary` are validated and
/// redacted — no secrets. Sensitive/destructive tools require an `AiApproval` before execution.
model AiToolInvocation {
  id             String                 @id @default(cuid())
  runId          String
  toolId         String // stable code-owned tool id
  status         AiToolInvocationStatus @default(REQUESTED)
  riskClass      AiToolRiskClass        @default(SAFE)
  approvalId     String?
  intentSnapshot Json?
  intentHash String?
  toolVersion Int?
  inputSchemaHash String?
  normalizedSchemaHash String?
  argsSnapshot   Json? // validated + redacted; the frozen normalized action input
  resultSummary  Json? // bounded; no secrets
  errorCode      String?
  durationMs     Int?
  startedAt      DateTime?
  finishedAt     DateTime?
  // Ordinal of the PROVIDER_CALL step that requested this action: with `runId` it identifies ONE
  // requested action (a provider response carries at most one tool call). NULL on legacy rows.
  originCall     Int?
  // `read_only` | `idempotent`, frozen at creation. NULL (legacy) is always treated as side-effecting.
  idempotency    String?
  // The run lease epoch that started the execution; result/failure writes must match it.
  executionEpoch Int?
  // Set once, in the same transaction as the ordering TOOL_INVOCATION step: the result/rejection has
  // been applied to the run transcript.
  appliedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  run      AiRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  approval AiApproval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@unique([runId, originCall])
  @@index([runId])
  @@index([approvalId])
  @@map("ai_tool_invocations")
  @@schema("ai")
}

/// Human-in-the-loop approval record (Arc E/F). `decidedBy` is the operator; SetNull so the
/// record survives operator deletion. Belongs to a run and/or conversation.
model AiApproval {
  id              String          @id @default(cuid())
  conversationId  String?
  runId           String?
  kind            AiApprovalKind
  state           AiApprovalState @default(PENDING)
  intentHash String?
  requestedReason String? // bounded
  decidedById     String?
  decidedAt       DateTime?
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  conversation    AiConversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run             AiRun?             @relation(fields: [runId], references: [id], onDelete: Cascade)
  decidedBy       User?              @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  toolInvocations AiToolInvocation[]

  @@index([conversationId])
  @@index([runId])
  @@index([state])
  // The approval-expiry sweep (Arc E.5) claims PENDING approvals whose TTL has elapsed.
  @@index([state, expiresAt])
  @@map("ai_approvals")
  @@schema("ai")
}
