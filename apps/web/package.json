{
  "name": "@amcore/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "node ../../scripts/check-product-admin-placement.mjs && node ../../scripts/render-product-admin-edge.mjs --check && next build",
    "start": "next start",
    "lint": "node ../../scripts/lint.mjs --scope web && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest --project=unit",
    "test:run": "vitest run --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:storybook": "vitest run --project=storybook",
    "test:e2e": "node ../../scripts/stand.mjs e2e --lane mocked",
    "test:e2e:real-stack": "node ../../scripts/stand.mjs e2e --lane real-stack",
    "test:e2e:console-real-stack": "node ../../scripts/stand.mjs e2e --lane console-real-stack",
    "lint:css": "stylelint \"src/**/*.css\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:fix": "node ../../scripts/lint.mjs --scope web --fix && stylelint \"src/**/*.css\" --fix"
  },
  "dependencies": {
    "@amcore/shared": "workspace:^",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@redis/client": "^5.12.1",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-table": "^9.3.1",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@amcore/typescript-config": "workspace:*",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.4",
    "@testcontainers/redis": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.3",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "path-to-regexp": "8.4.2",
    "shadcn": "^4.22.1",
    "storybook": "^10.6.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "@amcore/eslint-config": "workspace:*"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
