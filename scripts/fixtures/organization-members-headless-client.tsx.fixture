'use client'

import { useState } from 'react'
import { useLocale, useTranslations } from 'next-intl'
import type { MemberRolesResponse, ProductAccessBootstrap } from '@amcore/shared'

import { type MemberRemovalTarget, type OrganizationAccessController, useMemberRemoval, useMemberApiKeys, useMemberRoleAssignments, useOrganizationContext, useOrganizationMembers } from '@/entities/organization-context'
import { ApiErrorAlert } from '@/shared/ui/api-error-alert'
import { Button } from '@/shared/ui/button'
import { ConfirmDialog } from '@/shared/ui/confirm-dialog'

// Different presentation: list beside a persistent inline editor, no ready slices.
export function CustomMembers({ admission, id }: { admission: ProductAccessBootstrap; id: string; query?: { page: number; search: string }; membersHref?: string; listHref?: string; initialOrganizationName?: string; invitationsHref?: string; rolesHref?: string }) {
  const locale = useLocale()
  const t = useTranslations('organizationMembers')
  const context = useOrganizationContext(admission.binding, { kind: 'selected', id, locale })
  const members = useOrganizationMembers(context.controller, { page: 1, search: '' })
  const [removalTarget, setRemovalTarget] = useState<MemberRemovalTarget>()
  const removal = useMemberRemoval(context.controller, removalTarget)
  const removalLocked = removal.pending || removal.checking ||
    (removal.outcome?.status === 'unknown' && removal.inspection?.status !== 'different')
  const removalText = useTranslations('memberRemoval')
  const [selected, setSelected] = useState<string>()
  return <section className="space-y-6" data-testid="custom-headless-members">
    <h1 className="text-2xl font-semibold">{t('title')}</h1>
    <ApiErrorAlert error={context.state.error ?? members.error} />
    <div className="grid gap-6 md:grid-cols-2">
      <ul className="space-y-3">{members.ready && members.data?.data.map((member) => <li key={member.memberId}>
        <Button variant="outline" onClick={() => setSelected(member.user.id)}>{member.user.email}</Button>
        <Button variant="outline" disabled={removalLocked} onClick={() => {
          if (removalLocked || context.controller.isBusy()) return
          setRemovalTarget({ userId:member.user.id, memberId:member.memberId, email:member.user.email, name:member.user.name })
        }}>{removalText('action')}</Button>
      </li>)}</ul>
      {selected && <InlineRoles key={selected} controller={context.controller} userId={selected} actorId={admission.actor.id} />}
    </div>
    {selected && members.data?.data.find((m) => m.user.id === selected) && <InlineKeys
      controller={context.controller} userId={selected}
      memberId={members.data.data.find((m) => m.user.id === selected)!.memberId} />}
    {removalTarget && <InlineRemoval key={removalTarget.memberId} controller={context.controller} target={removalTarget} removal={removal} />}
    <Button onClick={() => void context.refresh()} disabled={context.state.status === 'pending' || context.controller.isBusy()}>{t('refresh')}</Button>
  </section>
}
function InlineRoles({ controller, userId, actorId }: { controller: OrganizationAccessController; userId: string; actorId: string }) {
  const t = useTranslations('organizationMembers')
  const roles = useMemberRoleAssignments(controller, { userId, page: 1, search: '', section: 'available' })
  const [snapshot, setSnapshot] = useState<MemberRolesResponse>()
  if (!snapshot && roles.data) setSnapshot(roles.data)
  const [draft, setDraft] = useState<string[]>()
  const [ack, setAck] = useState(false)
  const [notice, setNotice] = useState<'saved' | 'savedUnavailable' | 'unknown'>()
  const [error, setError] = useState<unknown>()
  const selected = draft ?? snapshot?.assignedRoles?.map((role) => role.id) ?? []
  const editable = snapshot?.editMode === 'editable'
  const original = snapshot?.assignedRoles?.map((role) => role.id) ?? []
  const changed = selected.length !== original.length || selected.some((id) => !original.includes(id))
  async function save() {
    if (!snapshot || !editable) return
    const result = await roles.save({ expectedMemberId: snapshot.member.memberId, expectedAclVersion: snapshot.aclVersion, roleIds: selected })
    if (result.status === 'retired') return
    if (result.status === 'committed') { setNotice(result.followup === 'ready' ? 'saved' : 'savedUnavailable'); setDraft(undefined); setSnapshot(undefined) }
    else if (result.status === 'unknown') setNotice('unknown')
    else if (result.status === 'rejected') setError(result.error)
  }
  return <section className="space-y-4 rounded-lg border p-4">
    <ApiErrorAlert error={error ?? roles.error} />
    {notice && <p role="status">{t(notice)}</p>}
    {roles.data && !editable && <p>{t(roles.data.editMode === 'oversized' ? 'oversized' : 'byteOversized')}</p>}
    {roles.data?.choices.data.map((role) => <label key={role.id} className="flex gap-2">
      <input type="checkbox" checked={selected.includes(role.id)} disabled={!editable || !roles.ready || roles.busy}
        onChange={(event) => { setDraft(event.target.checked ? [...selected, role.id] : selected.filter((id) => id !== role.id)); setAck(false) }} />{role.name}
    </label>)}
    {selected.length === 0 && <p>{t('zero')}</p>}
    {changed && userId === actorId && <label className="flex gap-2"><input type="checkbox" checked={ack} onChange={(e) => setAck(e.target.checked)} />{t('selfWarning')}</label>}
    <Button onClick={() => void save()} disabled={!editable || !roles.ready || roles.busy || notice === 'unknown' || (changed && userId === actorId && !ack)}>{t('save')}</Button>
  </section>
}

function InlineKeys({controller,userId,memberId}: {controller:OrganizationAccessController;userId:string;memberId:string}) {
  const t=useTranslations('memberApiKeys')
  const keys=useMemberApiKeys(controller,userId,{expectedMemberId:memberId,page:1,limit:20,status:'all'})
  const [confirm,setConfirm]=useState(false)
  const [notice,setNotice]=useState<string>()
  const [uncertain,setUncertain]=useState(false)
  async function revoke() {
    const result=await keys.revoke()
    if(result.status==='committed') setNotice(t('result',{count:result.result.affectedCount}))
    else if(result.status==='unknown'||result.status==='rejected') {setNotice(t(result.status));setUncertain(result.status==='unknown')}
  }
  return <section className="space-y-3 rounded-lg border p-4" data-testid="custom-headless-member-keys">
    <h2>{t('title')}</h2><ApiErrorAlert error={keys.error}/>
    {notice && <p role="status">{notice}</p>}
    {keys.available && keys.data?.data.map(key=><p key={key.id}>{key.name}</p>)}
    <Button variant="outline" disabled={!keys.available||keys.busy||uncertain||!keys.data?.revocableCount||keys.data.revocableCount>1000} onClick={()=>setConfirm(true)}>{t('revokeAll')}</Button>
    <Button variant="outline" onClick={()=>void keys.refresh().then(()=>setUncertain(false)).catch(()=>undefined)}>{t('check')}</Button>
    <ConfirmDialog open={confirm} onOpenChange={setConfirm} title={t('confirmAll')} description={t('allWarning')} confirmLabel={t('confirm')} cancelLabel={t('cancel')} variant="destructive" onConfirm={()=>void revoke()}/>
  </section>
}

// Independent inline confirmation consumes only the public domain hook; no ready removal feature.
function InlineRemoval({target,removal}:{controller:OrganizationAccessController;target:MemberRemovalTarget;removal:ReturnType<typeof useMemberRemoval>}) {
  const t=useTranslations('memberRemoval')
  const [ack,setAck]=useState(false)
  const outcome=removal.outcome
  return <section data-testid="custom-headless-removal" className="space-y-3 rounded-lg border p-4">
    <h2>{target.email}</h2>
    <label className="flex gap-2"><input type="checkbox" checked={ack} onChange={event=>setAck(event.target.checked)} />{t('warning')}</label>
    <Button variant="destructive" disabled={!ack||!removal.canRemove} onClick={()=>{setAck(false);void removal.remove()}}>{t('confirm')}</Button>
    {outcome?.status==='committed'&&<p role="status">{t('success')}</p>}
    {outcome?.status==='unknown'&&<p role="status">{t('unknown')}</p>}
    {outcome?.status==='rejected'&&<ApiErrorAlert error={outcome.error}/>}
    {outcome&&<Button onClick={()=>void removal.inspect()} disabled={removal.pending||removal.checking||Boolean(removal.retryAt)}>{t('check')}</Button>}
    {removal.inspection&&<p role="status">{t(removal.inspection.status)}</p>}
  </section>
}
