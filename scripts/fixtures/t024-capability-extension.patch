diff --git a/apps/api/test/fixture-order-access.e2e-spec.ts b/apps/api/test/fixture-order-access.e2e-spec.ts
new file mode 100644
index 0000000..f395187
--- /dev/null
+++ b/apps/api/test/fixture-order-access.e2e-spec.ts
@@ -0,0 +1,430 @@
+import type { INestApplication } from '@nestjs/common'
+import { JwtService } from '@nestjs/jwt'
+import request from 'supertest'
+
+import { type AccessConfiguredItem, type MemberAccess, memberAccessSchema } from '@amcore/shared'
+
+import { CAPABILITY_ADAPTERS } from '../src/core/organizations/capability-registry.service'
+import type { PrismaService } from '../src/prisma'
+
+import {
+  cleanDatabase,
+  cleanOrgData,
+  type E2ETestContext,
+  seedOrgMember,
+  seedSystemRoles,
+  setupE2ETest,
+  teardownE2ETest,
+} from './helpers'
+
+/**
+ * The downstream journey, end to end on PostgreSQL: a developer registers `FixtureOrder` operations
+ * (catalogue, adapter, model grammar: see the extension fixture), an administrator configures roles,
+ * assigns them to a member, and the member access explanation answers. Every answer is parsed with
+ * the shared schema and compared with what the real handlers decide on sample records.
+ *
+ * Authoring paths are named per case: `preset API` = role-definition save (the editor's route),
+ * `legacy API` = documented `POST /roles/:id/permissions` (advanced rules, DENY), `fixture rows` =
+ * direct insert, used only where the public routes refuse the rule.
+ */
+type Preset = [capability: 'fixtureOrder.read' | 'fixtureOrder.update', area: 'own' | 'assigned' | 'all']
+interface Rule {
+  action: 'read' | 'update'
+  conditions?: Record<string, unknown>
+  fields?: string[]
+}
+interface RoleSetup {
+  presets: Preset[]
+  /** DENY rules, authored through the legacy API. */
+  denies?: Rule[]
+  /** ALLOW rules a preset cannot express, authored through the legacy API. */
+  allows?: Rule[]
+}
+const NAMES = ['own', 'assigned', 'other', 'blocked', 'closed'] as const
+type Name = (typeof NAMES)[number]
+const ALL: Name[] = [...NAMES]
+
+interface Case {
+  title: string
+  authored: string
+  roles: RoleSetup[]
+  /** What the explanation says about `fixtureOrder.update`. */
+  explain: (item: AccessConfiguredItem, access: MemberAccess) => void
+  /** Records the real handler lets the member change, per field. */
+  status: Name[]
+  note: Name[]
+  /** Records the real list handler returns. */
+  listed: Name[]
+}
+
+const areaKinds = (item: AccessConfiguredItem) => item.areas.map((area) => area.kind)
+
+const CASES: Case[] = [
+  {
+    title: 'read own + update own: one area, prerequisite proven by the identical condition',
+    authored: 'preset API',
+    roles: [{ presets: [['fixtureOrder.read', 'own'], ['fixtureOrder.update', 'own']] }],
+    explain: (item) => {
+      expect(item.state).toBe('configured')
+      expect(areaKinds(item)).toEqual(['own'])
+      expect(item.areas[0]!.prerequisite).toBe('met')
+    },
+    status: ['own', 'closed'],
+    note: ['own', 'closed'],
+    listed: ['own', 'closed'],
+  },
+  {
+    title: 'read own + update assigned is not proven: the assigned record is not readable',
+    authored: 'preset API',
+    roles: [{ presets: [['fixtureOrder.read', 'own'], ['fixtureOrder.update', 'assigned']] }],
+    explain: (item) => {
+      expect(item.state).toBe('configured')
+      expect(item.areas).toMatchObject([{ kind: 'assigned', prerequisite: 'unproven' }])
+    },
+    status: [],
+    note: [],
+    listed: ['own', 'closed'],
+  },
+  {
+    title: 'update without any read is a missing prerequisite',
+    authored: 'preset API',
+    roles: [{ presets: [['fixtureOrder.update', 'all']] }],
+    explain: (item) => {
+      expect(item.state).toBe('missingPrerequisite')
+      expect(item.areas).toMatchObject([{ kind: 'all', prerequisite: 'missing' }])
+    },
+    status: [],
+    note: [],
+    listed: [],
+  },
+  {
+    title: 'an unconditional deny on a required read field blocks every update',
+    authored: 'preset API + legacy API (deny)',
+    roles: [
+      {
+        presets: [['fixtureOrder.read', 'all'], ['fixtureOrder.update', 'all']],
+        denies: [{ action: 'read', fields: ['status'] }],
+      },
+    ],
+    explain: (item) => {
+      expect(item.state).toBe('blocked')
+      expect(item.areas).toMatchObject([{ kind: 'all', prerequisite: 'blocked' }])
+      expect(item.blockedBy?.total).toBe(1)
+    },
+    status: [],
+    note: [],
+    listed: [],
+  },
+  {
+    title: 'a conditional read deny leaves the result dependent on the record',
+    authored: 'preset API + legacy API (deny)',
+    roles: [
+      {
+        presets: [['fixtureOrder.read', 'all'], ['fixtureOrder.update', 'all']],
+        denies: [{ action: 'read', conditions: { status: 'blocked' } }],
+      },
+    ],
+    explain: (item) => {
+      expect(item.state).toBe('configured')
+      expect(item.areas).toMatchObject([{ kind: 'all', prerequisite: 'unproven' }])
+    },
+    status: ['own', 'assigned', 'other', 'closed'],
+    note: ['own', 'assigned', 'other', 'closed'],
+    listed: ['own', 'assigned', 'other', 'closed'],
+  },
+  {
+    title: 'an allow and a deny with the identical condition mask the area',
+    authored: 'preset API + legacy API (deny)',
+    roles: [
+      {
+        presets: [['fixtureOrder.read', 'own'], ['fixtureOrder.update', 'own']],
+        denies: [
+          { action: 'update', conditions: { ownerId: '${user.sub}' }, fields: ['status', 'note'] },
+        ],
+      },
+    ],
+    explain: (item) => {
+      expect(item.state).toBe('blocked')
+      expect(item.areas).toMatchObject([{ kind: 'own', masked: true }])
+    },
+    status: [],
+    note: [],
+    listed: ['own', 'closed'],
+  },
+  {
+    title: 'a different conditional deny is a limit, nothing is guessed',
+    authored: 'preset API + legacy API (deny)',
+    roles: [
+      {
+        presets: [['fixtureOrder.read', 'own'], ['fixtureOrder.update', 'own']],
+        denies: [{ action: 'update', conditions: { status: 'closed' }, fields: ['status', 'note'] }],
+      },
+    ],
+    explain: (item) => {
+      expect(item.state).toBe('configured')
+      expect(item.limits).toEqual([{ kind: 'denyCondition' }])
+    },
+    status: ['own'],
+    note: ['own'],
+    listed: ['own', 'closed'],
+  },
+  {
+    title: 'an unconditional field deny blocks that field and limits the operation',
+    authored: 'preset API + legacy API (deny)',
+    roles: [
+      {
+        presets: [['fixtureOrder.read', 'all'], ['fixtureOrder.update', 'all']],
+        denies: [{ action: 'update', fields: ['note'] }],
+      },
+    ],
+    explain: (item, access) => {
+      expect(item.state).toBe('configured')
+      expect(item.limits).toEqual([{ kind: 'denyFields', fields: ['note'] }])
+      const field = (name: string) =>
+        access.items.find((entry) => entry.key === `fixtureOrder.update.${name}`)
+      expect(field('note')).toMatchObject({ state: 'blocked' })
+      expect(field('status')).toMatchObject({ state: 'allowed' })
+    },
+    status: ALL,
+    note: [],
+    listed: ALL,
+  },
+  {
+    title: 'own and assigned from two roles stay two independent areas',
+    authored: 'preset API',
+    roles: [
+      { presets: [['fixtureOrder.read', 'all'], ['fixtureOrder.update', 'own']] },
+      { presets: [['fixtureOrder.update', 'assigned']] },
+    ],
+    explain: (item) => {
+      expect(item.state).toBe('configured')
+      expect(areaKinds(item)).toEqual(['assigned', 'own'])
