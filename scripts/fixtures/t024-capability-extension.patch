+      organizationId: org, inverted: true, conditions: { status: 'done' },
+    } })
+    await prisma.rolePermission.createMany({ data: [fieldDeny, postStateDeny].map((rule) => ({
+      roleId: role.id, permissionId: rule.id,
+    })) })
+    await prisma.organization.update({ where: { id: org },
+      data: { aclVersion: { increment: 1 } } })
+    const withHints = (await request(app.getHttpServer()).get(list)
+      .set('Authorization', `Bearer ${staff.token}`).expect(200)).body
+    expect(withHints.data.find((row: { id: string }) => row.id === assigned.id)
+      .access.fields.status).toBe(true)
+    expect(withHints.data.find((row: { id: string }) => row.id === assigned.id)
+      .access.fields.note).toBe(false)
+    await request(app.getHttpServer()).patch(`${list}/${assigned.id}`)
+      .set('Authorization', `Bearer ${staff.token}`)
+      .send({ status: 'done' }).expect(403)
+    expect((await prisma.fixtureOrder.findUniqueOrThrow({ where: { id: assigned.id } }))
+      .status).toBe('review')
+    await request(app.getHttpServer()).patch(`${list}/${assigned.id}`)
+      .set('Authorization', `Bearer ${staff.token}`)
+      .send({ note: 'Forbidden' }).expect(403)
+    await request(app.getHttpServer()).patch(`${list}/${own.id}`)
+      .set('Authorization', `Bearer ${staff.token}`)
+      .send({ status: 'done' }).expect(403)
+    await request(app.getHttpServer()).patch(`${list}/${assigned.id}`)
+      .set('Authorization', `Bearer ${staff.token}`)
+      .send({ organizationId: otherOrg }).expect(400)
+    expect((await prisma.fixtureOrder.findUniqueOrThrow({ where: { id: assigned.id } }))
+      .organizationId).toBe(org)
+    await request(app.getHttpServer()).get(`/organizations/${otherOrg}/fixture-orders`)
+      .set('Authorization', `Bearer ${staff.token}`).expect(403)
+    const before = await prisma.organization.findUniqueOrThrow({ where: { id: org } })
+    const count = await prisma.permission.count({ where: { organizationId: org } })
+    await request(app.getHttpServer()).post(preset)
+      .set('Authorization', `Bearer ${owner.token}`)
+      .send({ capabilityId: 'fixtureOrder.read', presetId: 'notReal' }).expect(400)
+    await request(app.getHttpServer()).post(`/organizations/${org}/roles/${role.id}/permissions`)
+      .set('Authorization', `Bearer ${owner.token}`)
+      .send({ action: 'read', subject: 'FixtureOrder', fields: ['notReal'] }).expect(400)
+    await request(app.getHttpServer()).post(`/organizations/${org}/roles/${role.id}/permissions`)
+      .set('Authorization', `Bearer ${owner.token}`)
+      .send({ action: 'read', subject: 'FixtureOrder',
+        conditions: { status: { unknownOperator: 'draft' } } }).expect(400)
+    expect(await prisma.permission.count({ where: { organizationId: org } })).toBe(count)
+    expect((await prisma.organization.findUniqueOrThrow({ where: { id: org } })).aclVersion)
+      .toBe(before.aclVersion)
+    const readFieldDeny = await prisma.permission.create({ data: {
+      action: Action.Read, subject: Subject.FixtureOrder,
+      organizationId: org, inverted: true, fields: ['status'],
+      conditions: { id: assigned.id },
+    } })
+    await prisma.rolePermission.create({ data: {
+      roleId: role.id, permissionId: readFieldDeny.id,
+    } })
+    await prisma.organization.update({ where: { id: org },
+      data: { aclVersion: { increment: 1 } } })
+    const fieldFiltered = (await request(app.getHttpServer()).get(list)
+      .set('Authorization', `Bearer ${staff.token}`).expect(200)).body
+    expect(fieldFiltered.data.map((row: { id: string }) => row.id))
+      .toEqual([own.id])
+    expect(fieldFiltered.total).toBe(1)
+  })
+})
