diff --git a/apps/api/src/core/organizations/fixture-orders.controller.ts b/apps/api/src/core/organizations/fixture-orders.controller.ts
new file mode 100644
index 0000000..4c08cba
--- /dev/null
+++ b/apps/api/src/core/organizations/fixture-orders.controller.ts
@@ -0,0 +1,90 @@
+import { subject } from '@casl/ability'
+import { BadRequestException, Body, Controller, Get, Param, Patch } from '@nestjs/common'
+import { ApiBearerAuth, ApiOperation, ApiSecurity, ApiTags } from '@nestjs/swagger'
+import { createZodDto } from 'nestjs-zod'
+
+import {
+  Action, AuthType, type FixtureOrderUpdate, fixtureOrderUpdateSchema,
+  ORGANIZATION_CONTEXT_FAMILY,
+} from '@amcore/shared'
+
+import { ForbiddenException, NotFoundException } from '../../common/exceptions'
+import { PrismaService } from '../../prisma'
+import type { AppAbility } from '../auth/casl/ability.factory'
+import { accessibleBy, createCaslExtension } from '../auth/casl/prisma-ability'
+import { Auth } from '../auth/decorators/auth.decorator'
+import { CurrentAbility } from '../auth/decorators/current-ability.decorator'
+import {
+  OrganizationContextBoundary, RequestContextPolicy,
+} from '../auth/organization-context/request-context-policy'
+
+import type { FixtureOrder, Prisma } from '@/generated/prisma/client'
+
+class FixtureOrderUpdateDto extends createZodDto(fixtureOrderUpdateSchema) {}
+const MAX_SCAN = 200
+const PAGE_SIZE = 20
+
+const canRead = (ability: AppAbility, row: FixtureOrder): boolean => {
+  const record = subject('FixtureOrder', row)
+  return ability.can(Action.Read, record) &&
+    ['id', 'status'].every((field) => ability.can(Action.Read, record, field))
+}
+
+const hint = (ability: AppAbility, row: FixtureOrder) => {
+  const record = subject('FixtureOrder', row)
+  const fields = Object.fromEntries(['status', 'note'].map((field) => [field,
+    ability.can(Action.Update, record) && ability.can(Action.Update, record, field)]))
+  return { allowed: Object.values(fields).some(Boolean), fields }
+}
+
+@ApiTags('fixture-orders')
+@ApiBearerAuth()
+@ApiSecurity('apiKeyBearer')
+@Controller('organizations/:orgId/fixture-orders')
+@Auth(AuthType.Bearer, AuthType.ApiKey)
+@OrganizationContextBoundary(ORGANIZATION_CONTEXT_FAMILY)
+export class FixtureOrdersController {
+  constructor(private readonly prisma: PrismaService) {}
+
+  @Get()
+  @RequestContextPolicy({ kind: 'organization', selector: { param: 'orgId' },
+    legacyPlatformMembershipBypass: true })
+  @ApiOperation({ summary: 'List authorized fixture orders' })
+  async list(@Param('orgId') orgId: string, @CurrentAbility() ability: AppAbility) {
+    const client = this.prisma.$extends(createCaslExtension())
+    const where: Prisma.FixtureOrderWhereInput = {
+      AND: [{ organizationId: orgId }, accessibleBy(ability).ofType('FixtureOrder')],
+    }
+    const rows = await client.fixtureOrder.findMany({
+      where, orderBy: { id: 'asc' }, take: MAX_SCAN + 1,
+    })
+    if (rows.length > MAX_SCAN) throw new BadRequestException('Fixture order scan limit exceeded')
+    const visible = rows.filter((row) => canRead(ability, row))
+    const data = visible.slice(0, PAGE_SIZE).map((row) => ({
+      id: row.id, status: row.status, access: hint(ability, row),
+    }))
+    return { data, total: visible.length }
+  }
+
+  @Patch(':id')
+  @RequestContextPolicy({ kind: 'organization', selector: { param: 'orgId' },
+    legacyPlatformMembershipBypass: true })
+  @ApiOperation({ summary: 'Update authorized fixture order fields' })
+  async update(@Param('orgId') orgId: string, @Param('id') id: string,
+    @Body() input: FixtureOrderUpdateDto, @CurrentAbility() ability: AppAbility) {
+    return this.prisma.$transaction(async (tx) => {
+      await tx.$queryRaw`SELECT id FROM core.fixture_orders WHERE id = ${id} AND "organizationId" = ${orgId} FOR UPDATE`
+      const before = await tx.fixtureOrder.findUnique({ where: { id } })
+      if (!before || before.organizationId !== orgId) throw new NotFoundException('FixtureOrder', id)
+      const fields = Object.keys(input) as (keyof FixtureOrderUpdate)[]
+      const permitted = (row: FixtureOrder) => fields.every((field) =>
+        ability.can(Action.Update, subject('FixtureOrder', row), field))
+      if (!ability.can(Action.Update, subject('FixtureOrder', before)) || !permitted(before) ||
+        !canRead(ability, before)) throw new ForbiddenException('Fixture order denied')
+      const after = await tx.fixtureOrder.update({ where: { id }, data: input })
+      if (!ability.can(Action.Update, subject('FixtureOrder', after)) || !permitted(after) ||
+        !canRead(ability, after)) throw new ForbiddenException('Fixture order denied')
+      return { id: after.id, status: after.status }
+    })
+  }
+}
