+import type { INestApplication } from '@nestjs/common'
+import { JwtService } from '@nestjs/jwt'
+import request from 'supertest'
+
+import { Action, Subject } from '@amcore/shared'
+
+import type { PrismaService } from '../src/prisma'
+
+import {
+  cleanDatabase, cleanOrgData, type E2ETestContext, seedOrgMember,
+  seedSystemRoles, setupE2ETest, teardownE2ETest,
+} from './helpers'
+
+describe('disposable FixtureOrder resource extension on PostgreSQL', () => {
+  let context: E2ETestContext
+  let app: INestApplication
+  let prisma: PrismaService
+  beforeAll(async () => {
+    context = await setupE2ETest()
+    app = context.app
+    prisma = context.prisma
+    await seedSystemRoles(prisma)
+  }, 120000)
+  afterAll(async () => { await teardownE2ETest(context) }, 120000)
+  beforeEach(async () => {
+    await cleanOrgData(prisma)
+    await cleanDatabase(prisma, context.cache, context.throttlerStorage)
+  })
+
+  const register = async (email: string) => {
+    const response = await request(app.getHttpServer()).post('/auth/register')
+      .send({ email, password: 'StrongP@ss123' }).expect(201)
+    const token = response.body.accessToken as string
+    const userId = app.get(JwtService).verify(token).sub as string
+    return { token, userId }
+  }
+
+  it('compiles discovery/presets and enforces keys, roles, tenant, rows, DENY and fields', async () => {
+    const owner = await register('owner@fixture.test')
+    const staff = await register('staff@fixture.test')
+    const org = (await request(app.getHttpServer()).post('/organizations')
+      .set('Authorization', `Bearer ${owner.token}`)
+      .send({ name: 'Fixture North' }).expect(201)).body.id as string
+    const otherOrg = (await request(app.getHttpServer()).post('/organizations')
+      .set('Authorization', `Bearer ${owner.token}`)
+      .send({ name: 'Fixture South' }).expect(201)).body.id as string
+    const role = await prisma.role.create({ data: {
+      name: 'Fixture staff', organizationId: org,
+    } })
+    const assignedRole = await prisma.role.create({ data: {
+      name: 'Fixture assigned', organizationId: org,
+    } })
+    await seedOrgMember(prisma, { orgId: org, userId: staff.userId, roleId: role.id })
+    const staffMember = await prisma.orgMember.findUniqueOrThrow({
+      where: { userId_organizationId: { userId: staff.userId, organizationId: org } },
+    })
+    await prisma.memberRole.create({ data: { memberId: staffMember.id,
+      roleId: assignedRole.id } })
+    await prisma.organization.update({ where: { id: org }, data: { aclVersion: { increment: 1 } } })
+
+    const own = await prisma.fixtureOrder.create({ data: {
+      organizationId: org, ownerId: staff.userId, assignedToId: null,
+      status: 'draft', note: 'Owned',
+    } })
+    const assigned = await prisma.fixtureOrder.create({ data: {
+      organizationId: org, ownerId: owner.userId, assignedToId: staff.userId,
+      status: 'draft', note: 'Assigned',
+    } })
+    const denied = await prisma.fixtureOrder.create({ data: {
+      organizationId: org, ownerId: owner.userId, assignedToId: staff.userId,
+      status: 'blocked', note: 'Denied',
+    } })
+    await prisma.fixtureOrder.create({ data: {
+      organizationId: otherOrg, ownerId: staff.userId, assignedToId: staff.userId,
+      status: 'draft', note: 'Foreign',
+    } })
+
+    const key = (await request(app.getHttpServer()).post('/api-keys')
+      .set('Authorization', `Bearer ${owner.token}`)
+      .send({ name: 'Early wildcard', organizationId: org, scopes: ['read:all'] })
+      .expect(201)).body.key as string
+    const narrowKey = (await request(app.getHttpServer()).post('/api-keys')
+      .set('Authorization', `Bearer ${owner.token}`)
+      .send({ name: 'Early narrow', organizationId: org,
+        scopes: ['read:FixtureOrder'] }).expect(201)).body.key as string
+    const list = `/organizations/${org}/fixture-orders`
+    expect((await request(app.getHttpServer()).get(list)
+      .set('Authorization', `Bearer ${key}`).expect(200)).body.data).toEqual([])
+    expect((await request(app.getHttpServer()).get(list)
+      .set('Authorization', `Bearer ${narrowKey}`).expect(200)).body.data).toEqual([])
+    const ownerRoles = await prisma.memberRole.findMany({
+      where: { member: { userId: owner.userId, organizationId: org } },
+    })
+    const ownerGrant = await prisma.permission.create({ data: {
+      action: Action.Read, subject: Subject.FixtureOrder, organizationId: org,
+    } })
+    await prisma.rolePermission.create({ data: {
+      roleId: ownerRoles[0]!.roleId, permissionId: ownerGrant.id,
+    } })
+    await prisma.organization.update({ where: { id: org },
+      data: { aclVersion: { increment: 1 } } })
+    const keyRows = (await request(app.getHttpServer()).get(list)
+      .set('Authorization', `Bearer ${key}`).expect(200)).body
+    expect(keyRows.data.map((row: { id: string }) => row.id).sort())
+      .toEqual([own.id, assigned.id, denied.id].sort())
+    expect(keyRows.total).toBe(3)
