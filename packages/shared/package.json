{
  "name": "@amcore/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared schemas, types, and constants for AMCore",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "node ../../scripts/lint.mjs --scope shared",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@amcore/eslint-config": "workspace:*",
    "@amcore/typescript-config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "tsdown": "0.23.1"
  }
}
