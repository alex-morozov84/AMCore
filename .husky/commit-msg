pnpm commitlint --edit "$1"

# Guard against AI-tool attribution trailers (AGENTS.md: "Never add AI
# attribution to commits (no Co-Authored-By, no 'generated by' lines, no
# mention of the tool)"). This repo's contribution model has no human
# pair-commit convention (PR-only, one squashed commit per PR credited to
# the PR author), so any Co-Authored-By trailer here is, in practice, a
# coding agent's own attribution -- blocked unconditionally, not just when
# it names a known tool. The other patterns catch footer shapes that don't
# use a Co-Authored-By trailer at all.
if grep -iE '^(co-authored-by|claude-session):|generated (with|by).*(claude|anthropic|copilot|codex|cursor)|🤖 generated' "$1" >/dev/null; then
  echo "commit-msg: this commit message looks like it has an AI tool attribution line" >&2
  echo "commit-msg: (Co-Authored-By / Claude-Session / 'Generated with ...' / 🤖)." >&2
  echo "commit-msg: AGENTS.md bans this repo-wide -- remove the line(s) and commit again." >&2
  exit 1
fi
