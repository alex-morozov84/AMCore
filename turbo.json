{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalEnv": ["NEXT_PUBLIC_*"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/typecheck-native.mjs",
        "$TURBO_ROOT$/scripts/lib/native-typecheck*.mjs",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/lint.mjs",
        "$TURBO_ROOT$/scripts/lib/lint-*.mjs",
        "$TURBO_ROOT$/packages/eslint-config/**",
        "$TURBO_ROOT$/apps/web/node_modules/tailwindcss/theme.css",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/typecheck-native.mjs",
        "$TURBO_ROOT$/scripts/lib/native-typecheck*.mjs",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/scripts/typecheck-native.mjs"
      ]
    },
    "clean": {
      "cache": false
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
